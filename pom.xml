<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>jp.ac.example</groupId>
  <artifactId>jpcoar-validator</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <saxon.version>12.9</saxon.version>
    <schxslt2.version>1.11.2</schxslt2.version>

    <schematron.source>
      ${project.basedir}/schematron/jpcoar2.0.sch
    </schematron.source>
    <schematron.transpiler>
      ${project.build.directory}/schxslt2/content/transpile.xsl
    </schematron.transpiler>
    <schematron.output>
      ${project.basedir}/xslt/jpcoar2.0.xsl
    </schematron.output>
  </properties>

  <dependencies>
    <!-- Saxon-HE: XSLT 3.0 processor -->
    <dependency>
      <groupId>net.sf.saxon</groupId>
      <artifactId>Saxon-HE</artifactId>
      <version>${saxon.version}</version>
    </dependency>

    <!-- Schematron compiler -->
    <dependency>
      <groupId>name.dmaus.schxslt</groupId>
      <artifactId>schxslt2</artifactId>
      <version>${schxslt2.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>jpcoar-validator</finalName>

    <plugins>

      <!-- ====================================================
           Java source compilation
           ==================================================== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <!-- ====================================================
           Unpack SchXslt2 resources
           ==================================================== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>

        <executions>
          <execution>
            <id>unpack-schxslt2</id>
            <phase>generate-resources</phase>

            <goals>
              <goal>unpack</goal>
            </goals>

            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>name.dmaus.schxslt</groupId>
                  <artifactId>schxslt2</artifactId>
                  <version>${schxslt2.version}</version>
                  <type>jar</type>
                  <outputDirectory>
                    ${project.build.directory}/schxslt2
                  </outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ====================================================
           Compile Schematron to XSLT
           ==================================================== -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>

        <executions>
          <execution>
            <id>compile-schematron</id>
            <phase>process-resources</phase>

            <goals>
              <goal>exec</goal>
            </goals>

            <configuration>
              <executable>java</executable>
              <classpathScope>runtime</classpathScope>

              <arguments>
                <argument>-cp</argument>
                <classpath/>

                <argument>net.sf.saxon.Transform</argument>

                <argument>-s:${schematron.source}</argument>
                <argument>-xsl:${schematron.transpiler}</argument>
                <argument>-o:${schematron.output}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ====================================================
           Build a self-contained executable JAR
           ==================================================== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>

        <executions>
          <execution>
            <id>shade-validator</id>
            <phase>package</phase>

            <goals>
              <goal>shade</goal>
            </goals>

            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>

              <transformers>
                <transformer implementation=
                  "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ValidatorServer</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>