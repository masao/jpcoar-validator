# syntax=docker/dockerfile:1

ARG RUBY_VERSION=3.4

# ============================================================
# 1. Java build stage
# ============================================================
FROM maven:3.9-eclipse-temurin-21 AS java-build

WORKDIR /build

# Maven dependencies
COPY pom.xml ./
RUN mvn -B dependency:go-offline

# Java source and Schematron files
COPY src/ ./src/
COPY schematron/ ./schematron/
COPY xslt/ ./xslt/

# Build executable JAR
RUN mvn -B -DskipTests package


# ============================================================
# 2. Ruby build stage
# ============================================================
FROM ruby:${RUBY_VERSION}-trixie AS ruby-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    pkg-config \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./

RUN bundle config set path /usr/local/bundle && \
    bundle install


# ============================================================
# 3. Runtime base stage
# ============================================================
FROM ruby:${RUBY_VERSION}-trixie AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    libxml2 \
    libxml2-dev \
    ca-certificates \
    curl \
    bash \
    tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Ruby dependencies
COPY --from=ruby-build /usr/local/bundle /usr/local/bundle

# Application files
COPY . .

# Copy Java validator built by Maven
# Adjust the filename to match the fat JAR generated by pom.xml
COPY --from=java-build \
    /build/target/jpcoar-validator-0.1.0-SNAPSHOT.jar \
    /app/jpcoar-validator.jar

# Ensure startup script is executable
RUN chmod +x /app/bin/run-with-validator

# Java artifacts
COPY --from=java-build /build/target/ /app/target/

# XML Catalog
ENV XML_CATALOG_FILES=/app/catalog.xml

# Internal Java HTTP validator
ENV JAVA_VALIDATOR_URL=http://127.0.0.1:9000/validate

# Ruby runtime
ENV BUNDLE_PATH=/usr/local/bundle
ENV LANG=C.UTF-8

# Start both Java and Ruby through the process manager script
ENTRYPOINT ["/usr/bin/tini", "--", "/app/bin/run-with-validator"]


# ============================================================
# 4. Test stage (GitHub Actions)
# ============================================================
FROM base AS test

ENV RACK_ENV=test

CMD ["bundle", "exec", "rspec"]


# ============================================================
# 5. Production stage (Render)
# ============================================================
FROM base AS production

ENV RACK_ENV=production
ENV PORT=10000

EXPOSE 10000

# Replace this with the actual web application command.
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]